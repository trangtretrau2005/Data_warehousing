  DTS:Description="CoffeeDW SSIS Package for TN04: Isolated SCD Type 1 (typo overwrite), Type 2 (effective boundary, no overlap, single current, idempotent replay), and Type 3 (2-step history limit)."
  DTS:DTSID="{86DCF868-7944-45AB-904A-6E7D20A7D7BC}"
