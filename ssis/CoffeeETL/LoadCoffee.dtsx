  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\EST_01_RegisterBatchAndStageRaw"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Generate BatchID, compute SHA-256 checksum of source CSV, register audit.LoadBatch, and stage raw CSV rows + RejectReason into stg.CoffeeRaw."
      DTS:DTSID="{B50DA93E-0BF7-4689-8FDA-AC58EC53F9F9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_01_RegisterBatchAndStageRaw"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1B2C47DE-720E-4B47-9204-7BE4A5EB641B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET QUOTED_IDENTIFIER ON;&#xA;SET ANSI_NULLS ON;&#xA;&#xA;DECLARE @FilePath nvarchar(500) = @SourceFilePath;&#xA;DECLARE @FileName nvarchar(500) = RIGHT(@FilePath, CHARINDEX('\', REVERSE(@FilePath) + '\') - 1);&#xA;DECLARE @BatchID uniqueidentifier = NEWID();&#xA;&#xA;-- 1. Read raw file bytes to compute exact SHA-256 checksum&#xA;CREATE TABLE #FileBlob (BulkColumn varbinary(max));&#xA;DECLARE @BlobSql nvarchar(max) = N'INSERT INTO #FileBlob SELECT BulkColumn FROM OPENROWSET(BULK N''' + REPLACE(@FilePath, '''', '''''') + N''', SINGLE_BLOB) AS b;';&#xA;EXEC sp_executesql @BlobSql;&#xA;&#xA;DECLARE @Checksum char(64) = (&#xA;    SELECT LOWER(CONVERT(char(64), HASHBYTES('SHA2_256', BulkColumn), 2))&#xA;    FROM #FileBlob&#xA;);&#xA;&#xA;-- 2. Read raw CSV lines (UTF-8) preserving physical line order&#xA;CREATE TABLE #RawLines (LineText nvarchar(max));&#xA;DECLARE @BulkSql nvarchar(max) = N'BULK INSERT #RawLines FROM N''' + REPLACE(@FilePath, '''', '''''') + N''' WITH (FIRSTROW = 2, CODEPAGE = ''65001'', ROWTERMINATOR = ''0x0a'', FIELDTERMINATOR = ''\0'');';&#xA;EXEC sp_executesql @BulkSql;&#xA;&#xA;CREATE TABLE #NumberedLines (&#xA;    SourceRow int IDENTITY(2,1) PRIMARY KEY,&#xA;    CleanLine nvarchar(max)&#xA;);&#xA;INSERT INTO #NumberedLines (CleanLine)&#xA;SELECT REPLACE(LineText, CHAR(13), N'')&#xA;FROM #RawLines&#xA;WHERE LEN(REPLACE(LineText, CHAR(13), N'')) &gt; 0;&#xA;&#xA;DECLARE @SourceCount int = (SELECT COUNT(*) FROM #NumberedLines);&#xA;&#xA;-- 3. Register Batch in audit.LoadBatch (outside usp_LoadCoffee transaction so failures remain traceable)&#xA;INSERT INTO audit.LoadBatch (BatchID, SourceFile, SourceChecksum, StartedAt, Status, SourceCount)&#xA;VALUES (@BatchID, @FileName, @Checksum, SYSUTCDATETIME(), 'STAGED', @SourceCount);&#xA;&#xA;-- 4. Split 20 CSV columns using OPENJSON array over RFC-compliant CSV values&#xA;;WITH SplitCols AS (&#xA;    SELECT&#xA;        n.SourceRow,&#xA;        n.CleanLine,&#xA;        MAX(CASE WHEN j.[key] = 0  THEN LTRIM(RTRIM(j.[value])) END) AS [Area Code],&#xA;        MAX(CASE WHEN j.[key] = 1  THEN LTRIM(RTRIM(j.[value])) END) AS [Date],&#xA;        MAX(CASE WHEN j.[key] = 2  THEN LTRIM(RTRIM(j.[value])) END) AS [Market],&#xA;        MAX(CASE WHEN j.[key] = 3  THEN LTRIM(RTRIM(j.[value])) END) AS [Market Size],&#xA;        MAX(CASE WHEN j.[key] = 4  THEN LTRIM(RTRIM(j.[value])) END) AS [Product],&#xA;        MAX(CASE WHEN j.[key] = 5  THEN LTRIM(RTRIM(j.[value])) END) AS [Product Line],&#xA;        MAX(CASE WHEN j.[key] = 6  THEN LTRIM(RTRIM(j.[value])) END) AS [Product Type],&#xA;        MAX(CASE WHEN j.[key] = 7  THEN LTRIM(RTRIM(j.[value])) END) AS [State],&#xA;        MAX(CASE WHEN j.[key] = 8  THEN LTRIM(RTRIM(j.[value])) END) AS [Type],&#xA;        MAX(CASE WHEN j.[key] = 9  THEN LTRIM(RTRIM(j.[value])) END) AS [Budget COGS],&#xA;        MAX(CASE WHEN j.[key] = 10 THEN LTRIM(RTRIM(j.[value])) END) AS [Budget Margin],&#xA;        MAX(CASE WHEN j.[key] = 11 THEN LTRIM(RTRIM(j.[value])) END) AS [Budget Profit],&#xA;        MAX(CASE WHEN j.[key] = 12 THEN LTRIM(RTRIM(j.[value])) END) AS [Budget Sales],&#xA;        MAX(CASE WHEN j.[key] = 13 THEN LTRIM(RTRIM(j.[value])) END) AS [COGS],&#xA;        MAX(CASE WHEN j.[key] = 14 THEN LTRIM(RTRIM(j.[value])) END) AS [Inventory],&#xA;        MAX(CASE WHEN j.[key] = 15 THEN LTRIM(RTRIM(j.[value])) END) AS [Margin],&#xA;        MAX(CASE WHEN j.[key] = 16 THEN LTRIM(RTRIM(j.[value])) END) AS [Marketing],&#xA;        MAX(CASE WHEN j.[key] = 17 THEN LTRIM(RTRIM(j.[value])) END) AS [Profit],&#xA;        MAX(CASE WHEN j.[key] = 18 THEN LTRIM(RTRIM(j.[value])) END) AS [Sales],&#xA;        MAX(CASE WHEN j.[key] = 19 THEN LTRIM(RTRIM(j.[value])) END) AS [Total Expenses]&#xA;    FROM #NumberedLines n&#xA;    CROSS APPLY OPENJSON(N'[&quot;' + REPLACE(STRING_ESCAPE(n.CleanLine, 'json'), N',', N'&quot;,&quot;') + N'&quot;]') j&#xA;    GROUP BY n.SourceRow, n.CleanLine&#xA;),&#xA;Parsed AS (&#xA;    SELECT&#xA;        s.*,&#xA;        (&#xA;            SELECT&#xA;                s.[Area Code] AS [Area Code], s.[Date] AS [Date], s.[Market] AS [Market],&#xA;                s.[Market Size] AS [Market Size], s.[Product] AS [Product],&#xA;                s.[Product Line] AS [Product Line], s.[Product Type] AS [Product Type],&#xA;                s.[State] AS [State], s.[Type] AS [Type],&#xA;                s.[Budget COGS] AS [Budget COGS], s.[Budget Margin] AS [Budget Margin],&#xA;                s.[Budget Profit] AS [Budget Profit], s.[Budget Sales] AS [Budget Sales],&#xA;                s.[COGS] AS [COGS], s.[Inventory] AS [Inventory], s.[Margin] AS [Margin],&#xA;                s.[Marketing] AS [Marketing], s.[Profit] AS [Profit], s.[Sales] AS [Sales],&#xA;                s.[Total Expenses] AS [Total Expenses]&#xA;            FOR JSON PATH, WITHOUT_ARRAY_WRAPPER&#xA;        ) AS RawJson,&#xA;        TRY_CONVERT(int, s.[Date]) AS DateSerial,&#xA;        CASE&#xA;            WHEN TRY_CONVERT(int, s.[Date]) IS NOT NULL&#xA;            THEN DATEADD(day, TRY_CONVERT(int, s.[Date]), CONVERT(date, '1899-12-30'))&#xA;            ELSE NULL&#xA;        END AS CalcMonthStart,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Sales], N'')) AS vSales,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Budget Sales], N'')) AS vBudgetSales,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Profit], N'')) AS vProfit,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Budget Profit], N'')) AS vBudgetProfit,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[COGS], N'')) AS vCOGS,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Budget COGS], N'')) AS vBudgetCOGS,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Margin], N'')) AS vMargin,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Budget Margin], N'')) AS vBudgetMargin,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Marketing], N'')) AS vMarketing,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Inventory], N'')) AS vInventory,&#xA;        TRY_CONVERT(decimal(19,4), NULLIF(s.[Total Expenses], N'')) AS vTotalExpenses&#xA;    FROM SplitCols s&#xA;)&#xA;SELECT&#xA;    p.SourceRow,&#xA;    p.RawJson,&#xA;    p.CalcMonthStart AS MonthStart,&#xA;    CASE&#xA;        WHEN p.CalcMonthStart IS NOT NULL AND DAY(p.CalcMonthStart) = 1&#xA;        THEN CONVERT(int, CONVERT(char(8), p.CalcMonthStart, 112))&#xA;        ELSE NULL&#xA;    END AS DateKey,&#xA;    NULLIF(p.[Area Code], N'') AS AreaCode,&#xA;    NULLIF(p.[State], N'') AS [State],&#xA;    NULLIF(p.[Market], N'') AS Market,&#xA;    NULLIF(p.[Market Size], N'') AS MarketSize,&#xA;    NULLIF(p.[Product], N'') AS ProductName,&#xA;    NULLIF(p.[Product Line], N'') AS ProductLine,&#xA;    NULLIF(p.[Product Type], N'') AS ProductType,&#xA;    NULLIF(p.[Type], N'') AS [Type],&#xA;    p.vSales AS Sales, p.vBudgetSales AS BudgetSales,&#xA;    p.vProfit AS Profit, p.vBudgetProfit AS BudgetProfit,&#xA;    p.vCOGS AS COGS, p.vBudgetCOGS AS BudgetCOGS,&#xA;    p.vMargin AS Margin, p.vBudgetMargin AS BudgetMargin,&#xA;    p.vMarketing AS Marketing, p.vInventory AS Inventory,&#xA;    p.vTotalExpenses AS TotalExpenses,&#xA;    STUFF(&#xA;        CONCAT(&#xA;            CASE WHEN NULLIF(p.[Area Code], N'') IS NULL THEN N'; AreaCode: required' ELSE N'' END,&#xA;            CASE WHEN NULLIF(p.[State], N'') IS NULL THEN N'; State: required' ELSE N'' END,&#xA;            CASE WHEN NULLIF(p.[Market], N'') IS NULL THEN N'; Market: required' ELSE N'' END,&#xA;            CASE WHEN NULLIF(p.[Market Size], N'') IS NULL THEN N'; MarketSize: required' ELSE N'' END,&#xA;            CASE WHEN NULLIF(p.[Product], N'') IS NULL THEN N'; ProductName: required' ELSE N'' END,&#xA;            CASE WHEN NULLIF(p.[Product Line], N'') IS NULL THEN N'; ProductLine: required' ELSE N'' END,&#xA;            CASE WHEN NULLIF(p.[Product Type], N'') IS NULL THEN N'; ProductType: required' ELSE N'' END,&#xA;            CASE WHEN NULLIF(p.[Type], N'') IS NULL THEN N'; Type: required' ELSE N'' END,&#xA;            CASE WHEN p.CalcMonthStart IS NULL OR DAY(p.CalcMonthStart) &lt;&gt; 1 THEN N'; Date: invalid Excel month-start serial' ELSE N'' END,&#xA;            CASE WHEN p.vSales IS NULL THEN N'; Sales: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vBudgetSales IS NULL THEN N'; BudgetSales: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vProfit IS NULL THEN N'; Profit: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vBudgetProfit IS NULL THEN N'; BudgetProfit: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vCOGS IS NULL THEN N'; COGS: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vBudgetCOGS IS NULL THEN N'; BudgetCOGS: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vMargin IS NULL THEN N'; Margin: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vBudgetMargin IS NULL THEN N'; BudgetMargin: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vMarketing IS NULL THEN N'; Marketing: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vInventory IS NULL THEN N'; Inventory: invalid numeric value' ELSE N'' END,&#xA;            CASE WHEN p.vTotalExpenses IS NULL THEN N'; TotalExpenses: invalid numeric value' ELSE N'' END&#xA;        ), 1, 2, N''&#xA;    ) AS RejectReason&#xA;INTO #StagePrep&#xA;FROM Parsed p;&#xA;&#xA;-- 5. Conditional Split check for duplicate candidate grain or conflicting dimension attributes among structurally valid rows&#xA;;WITH DupGrain AS (&#xA;    SELECT DateKey, AreaCode, ProductName&#xA;    FROM #StagePrep&#xA;    WHERE RejectReason IS NULL&#xA;    GROUP BY DateKey, AreaCode, ProductName&#xA;    HAVING COUNT(*) &gt; 1&#xA;)&#xA;UPDATE sp&#xA;SET RejectReason = N'duplicate candidate grain'&#xA;FROM #StagePrep sp&#xA;JOIN DupGrain d ON sp.DateKey = d.DateKey AND sp.AreaCode = d.AreaCode AND sp.ProductName = d.ProductName&#xA;WHERE sp.RejectReason IS NULL;&#xA;&#xA;;WITH BadArea AS (&#xA;    SELECT AreaCode&#xA;    FROM #StagePrep&#xA;    WHERE RejectReason IS NULL&#xA;    GROUP BY AreaCode&#xA;    HAVING COUNT(DISTINCT [State]) &gt; 1 OR COUNT(DISTINCT Market) &gt; 1 OR COUNT(DISTINCT MarketSize) &gt; 1&#xA;)&#xA;UPDATE sp&#xA;SET RejectReason = COALESCE(sp.RejectReason + N'; ', N'') + N'conflicting attributes for AreaCode'&#xA;FROM #StagePrep sp&#xA;JOIN BadArea ba ON sp.AreaCode = ba.AreaCode;&#xA;&#xA;;WITH BadProd AS (&#xA;    SELECT ProductName&#xA;    FROM #StagePrep&#xA;    WHERE RejectReason IS NULL&#xA;    GROUP BY ProductName&#xA;    HAVING COUNT(DISTINCT ProductLine) &gt; 1 OR COUNT(DISTINCT ProductType) &gt; 1 OR COUNT(DISTINCT [Type]) &gt; 1&#xA;)&#xA;UPDATE sp&#xA;SET RejectReason = COALESCE(sp.RejectReason + N'; ', N'') + N'conflicting attributes for ProductName'&#xA;FROM #StagePrep sp&#xA;JOIN BadProd bp ON sp.ProductName = bp.ProductName;&#xA;&#xA;-- 6. Populate stg.CoffeeRaw (valid rows have RejectReason IS NULL; rejected rows have fields nulled and RejectReason set)&#xA;INSERT INTO stg.CoffeeRaw (&#xA;    BatchID, SourceRow, RawJson, RejectReason,&#xA;    MonthStart, DateKey, AreaCode, [State], Market, MarketSize,&#xA;    ProductName, ProductLine, ProductType, [Type],&#xA;    Sales, BudgetSales, Profit, BudgetProfit, COGS, BudgetCOGS,&#xA;    Margin, BudgetMargin, Marketing, Inventory, TotalExpenses&#xA;)&#xA;SELECT&#xA;    @BatchID,&#xA;    SourceRow,&#xA;    RawJson,&#xA;    RejectReason,&#xA;    CASE WHEN RejectReason IS NULL THEN MonthStart ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN DateKey ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN AreaCode ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN [State] ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN Market ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN MarketSize ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN ProductName ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN ProductLine ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN ProductType ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN [Type] ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN Sales ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN BudgetSales ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN Profit ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN BudgetProfit ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN COGS ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN BudgetCOGS ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN Margin ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN BudgetMargin ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN Marketing ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN Inventory ELSE NULL END,&#xA;    CASE WHEN RejectReason IS NULL THEN TotalExpenses ELSE NULL END&#xA;FROM #StagePrep&#xA;ORDER BY SourceRow;&#xA;&#xA;SELECT CAST(@BatchID AS nvarchar(50)) AS BatchID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::BatchID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="@SourceFilePath"
            SQLTask:DtsVariableName="User::SourceFilePath"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="16"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_02_ExecuteUspLoadCoffee"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Call dw.usp_LoadCoffee @BatchID to atomically load dimensions, upsert FactSalesPerformance, route RejectedRow, and reconcile counts."
      DTS:DTSID="{F0E5B595-1F18-4BFD-A547-BB5941F89995}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_02_ExecuteUspLoadCoffee"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1B2C47DE-720E-4B47-9204-7BE4A5EB641B}"
          SQLTask:SqlStatementSource="DECLARE @b uniqueidentifier = CAST(@BatchID AS uniqueidentifier); EXEC dw.usp_LoadCoffee @BatchID = @b;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="@BatchID"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="16"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[{605CBA71-FC38-4519-9974-569A659526DE\}]"
      DTS:CreationName=""
      DTS:DTSID="{605CBA71-FC38-4519-9974-569A659526DE}"
      DTS:From="Package\EST_01_RegisterBatchAndStageRaw"
      DTS:LogicalAnd="True"
      DTS:ObjectName="{605CBA71-FC38-4519-9974-569A659526DE}"
      DTS:To="Package\EST_02_ExecuteUspLoadCoffee" />
  </DTS:PrecedenceConstraints>
  <DTS:EventHandlers>
    <DTS:EventHandler
      DTS:refId="Package.EventHandlers[OnError]"
      DTS:CreationName="OnError"
      DTS:DTSID="{D942C0CD-F790-4911-9DB6-8464EB5D6A76}"
      DTS:EventID="7143541"
      DTS:EventName="OnError"
      DTS:LocaleID="-1">
      <DTS:Variables>
        <DTS:Variable
          DTS:CreationName=""
          DTS:Description="The propagate property of the event"
          DTS:DTSID="{6BDAE77C-90C3-4497-820D-66974A413271}"
          DTS:IncludeInDebugDump="6789"
          DTS:Namespace="System"
          DTS:ObjectName="Propagate">
          <DTS:VariableValue
            DTS:DataType="11">-1</DTS:VariableValue>
        </DTS:Variable>
      </DTS:Variables>
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\EST_OnError_LogFailedBatch"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Update audit.LoadBatch Status = FAILED outside rolled-back transaction so failure remains traceable."
          DTS:DTSID="{161C7A90-A71D-4984-8E48-2EAF629EE461}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="EST_OnError_LogFailedBatch">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1B2C47DE-720E-4B47-9204-7BE4A5EB641B}"
              SQLTask:SqlStatementSource="UPDATE audit.LoadBatch SET Status = 'FAILED', FinishedAt = SYSUTCDATETIME() WHERE BatchID = TRY_CAST(@BatchID AS uniqueidentifier) AND Status = 'STAGED';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="@BatchID"
                SQLTask:DtsVariableName="User::BatchID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="16"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:EventHandler>
  </DTS:EventHandlers>
</DTS:Executable>