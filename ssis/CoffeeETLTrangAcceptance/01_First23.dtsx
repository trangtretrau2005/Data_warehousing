    <DTS:Executable
      DTS:refId="Package\EST_01_RegisterBatch"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{B487F05B-935E-49DB-A1D0-7E3FD5714FC5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_01_RegisterBatch"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E98EA756-1D9B-4FEC-8311-C36439F110B7}"
          SQLTask:SqlStatementSource="IF DB_NAME() NOT LIKE N'CoffeeDW[_]Trang[_]%' THROW 50201,'Use an isolated CoffeeDW_Trang database',1; DECLARE @b uniqueidentifier=CONVERT(uniqueidentifier,?); DECLARE @file nvarchar(1024)=?; DECLARE @hash char(64)=?; DECLARE @n int=?; IF @hash=REPLICATE('0',64) THROW 50200,'Use Run-CoffeeETL.ps1 to supply actual SHA256 and source count',1; INSERT audit.LoadBatch(BatchID,SourceFile,SourceChecksum,SourceCount) VALUES(@b,@file,@hash,@n);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="1024" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::SourceFileName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="1024" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::SourceChecksum"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="1024" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::SourceCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
