    <DTS:Executable
      DTS:refId="Package\EST_00_Preflight"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{720FE5D0-C241-4A45-B058-05534F4FF821}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_00_Preflight"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{95F23F41-6D38-4206-A584-BF8ABF712315}"
          SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'CoffeeDW_Trang_SSIS_TN03_20261120' THROW 50300,'Wrong acceptance database',1; &#xA;IF (SELECT COUNT_BIG(*) FROM dw.FactSalesPerformance)&lt;&gt;0 THROW 50301,'Acceptance requires empty fact; use a fresh initialized DB, do not delete data',1;&#xA;IF OBJECT_ID('audit.SSISAcceptanceSuite') IS NULL&#xA; CREATE TABLE audit.SSISAcceptanceSuite(SuiteID uniqueidentifier NOT NULL PRIMARY KEY,ManifestSHA256 char(64) NOT NULL,StartedAtUTC datetime2 NOT NULL DEFAULT SYSUTCDATETIME(),FinishedAtUTC datetime2 NULL,Status varchar(20) NOT NULL);&#xA;IF OBJECT_ID('audit.SSISAcceptanceCase') IS NULL&#xA; CREATE TABLE audit.SSISAcceptanceCase(SuiteID uniqueidentifier NOT NULL,CaseNumber int NOT NULL,BatchID uniqueidentifier NOT NULL,VerifiedAtUTC datetime2 NOT NULL DEFAULT SYSUTCDATETIME(),WarehouseRows bigint NOT NULL,WarehouseSales decimal(19,4) NOT NULL,PRIMARY KEY(SuiteID,CaseNumber));&#xA;INSERT audit.SSISAcceptanceSuite(SuiteID,ManifestSHA256,Status) VALUES(CONVERT(uniqueidentifier,N'63d2403b-e12f-495d-a3ce-69efce27f1a6'),N'88ba9eac77111bce13451ee5c504a81c699c41cc9d9319cc791d2d85a88645c1','RUNNING');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_01_Verify"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{1193E9A3-ACD1-4F93-AFBC-8659016999DF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_01_Verify"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{95F23F41-6D38-4206-A584-BF8ABF712315}"
          SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'CoffeeDW_Trang_SSIS_TN03_20261120' THROW 50300,'Wrong acceptance database',1; DECLARE @b uniqueidentifier=CONVERT(uniqueidentifier,N'fb522b30-cfef-4c0b-84df-4ed1169379a4');&#xA;IF NOT EXISTS(SELECT 1 FROM audit.LoadBatch WHERE BatchID=@b AND Status='COMPLETED'&#xA; AND SourceCount=4071 AND AcceptedCount=4071 AND RejectedCount=0 AND InsertedCount=4071 AND UpdatedCount=0 AND UnchangedCount=0) THROW 50302,'Batch counts mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.CoffeeRaw WHERE BatchID=@b)&lt;&gt;4071 THROW 50303,'Staging count mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM audit.RejectedRow WHERE BatchID=@b)&lt;&gt;0 THROW 50304,'Reject count mismatch',1;&#xA;IF (SELECT SUM(Sales) FROM stg.CoffeeRaw WHERE BatchID=@b AND RejectReason IS NULL)&lt;&gt;784231 THROW 50305,'Batch accepted Sales mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM dw.FactSalesPerformance)&lt;&gt;4071 THROW 50306,'Warehouse row count mismatch',1;&#xA;IF (SELECT SUM(Sales) FROM dw.FactSalesPerformance)&lt;&gt;784231 THROW 50307,'Warehouse Sales mismatch',1;&#xA;IF (SELECT SUM(BudgetSales) FROM dw.FactSalesPerformance)&lt;&gt;715340 THROW 50308,'Warehouse Budget mismatch',1;&#xA;IF (SELECT SUM(Profit) FROM dw.FactSalesPerformance)&lt;&gt;246454 THROW 50309,'Warehouse Profit mismatch',1;&#xA;INSERT audit.SSISAcceptanceCase(SuiteID,CaseNumber,BatchID,WarehouseRows,WarehouseSales)&#xA;VALUES(CONVERT(uniqueidentifier,N'63d2403b-e12f-495d-a3ce-69efce27f1a6'),1,@b,4071,784231);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_02_Verify"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{A5E85AAC-A1C1-4770-B694-62D9438871D1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_02_Verify"
