          SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'CoffeeDW_Trang_SSIS_TN03_20261120' THROW 50300,'Wrong acceptance database',1; DECLARE @b uniqueidentifier=CONVERT(uniqueidentifier,N'35cb2851-7bd4-4ae3-93f3-f9b4c8386fa0');&#xA;IF NOT EXISTS(SELECT 1 FROM audit.LoadBatch WHERE BatchID=@b AND Status='COMPLETED'&#xA; AND SourceCount=177 AND AcceptedCount=177 AND RejectedCount=0 AND InsertedCount=0 AND UpdatedCount=0 AND UnchangedCount=177) THROW 50302,'Batch counts mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.CoffeeRaw WHERE BatchID=@b)&lt;&gt;177 THROW 50303,'Staging count mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM audit.RejectedRow WHERE BatchID=@b)&lt;&gt;0 THROW 50304,'Reject count mismatch',1;&#xA;IF (SELECT SUM(Sales) FROM stg.CoffeeRaw WHERE BatchID=@b AND RejectReason IS NULL)&lt;&gt;35580 THROW 50305,'Batch accepted Sales mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM dw.FactSalesPerformance)&lt;&gt;4248 THROW 50306,'Warehouse row count mismatch',1;&#xA;IF (SELECT SUM(Sales) FROM dw.FactSalesPerformance)&lt;&gt;819811 THROW 50307,'Warehouse Sales mismatch',1;&#xA;IF (SELECT SUM(BudgetSales) FROM dw.FactSalesPerformance)&lt;&gt;746160 THROW 50308,'Warehouse Budget mismatch',1;&#xA;IF (SELECT SUM(Profit) FROM dw.FactSalesPerformance)&lt;&gt;259543 THROW 50309,'Warehouse Profit mismatch',1;&#xA;INSERT audit.SSISAcceptanceCase(SuiteID,CaseNumber,BatchID,WarehouseRows,WarehouseSales)&#xA;VALUES(CONVERT(uniqueidentifier,N'63d2403b-e12f-495d-a3ce-69efce27f1a6'),3,@b,4248,819811);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
