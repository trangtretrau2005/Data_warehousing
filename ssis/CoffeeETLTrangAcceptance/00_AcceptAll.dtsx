          SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'CoffeeDW_Trang_SSIS_TN03_20261120' THROW 50300,'Wrong acceptance database',1; DECLARE @b uniqueidentifier=CONVERT(uniqueidentifier,N'28896966-8fd0-4fbf-938b-77fe62a38a6d');&#xA;IF NOT EXISTS(SELECT 1 FROM audit.LoadBatch WHERE BatchID=@b AND Status='COMPLETED'&#xA; AND SourceCount=4248 AND AcceptedCount=4247 AND RejectedCount=1 AND InsertedCount=0 AND UpdatedCount=0 AND UnchangedCount=4247) THROW 50302,'Batch counts mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.CoffeeRaw WHERE BatchID=@b)&lt;&gt;4248 THROW 50303,'Staging count mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM audit.RejectedRow WHERE BatchID=@b)&lt;&gt;1 THROW 50304,'Reject count mismatch',1;&#xA;IF (SELECT SUM(Sales) FROM stg.CoffeeRaw WHERE BatchID=@b AND RejectReason IS NULL)&lt;&gt;819592 THROW 50305,'Batch accepted Sales mismatch',1;&#xA;IF (SELECT COUNT_BIG(*) FROM dw.FactSalesPerformance)&lt;&gt;4248 THROW 50306,'Warehouse row count mismatch',1;&#xA;IF (SELECT SUM(Sales) FROM dw.FactSalesPerformance)&lt;&gt;819811 THROW 50307,'Warehouse Sales mismatch',1;&#xA;IF (SELECT SUM(BudgetSales) FROM dw.FactSalesPerformance)&lt;&gt;746160 THROW 50308,'Warehouse Budget mismatch',1;&#xA;IF (SELECT SUM(Profit) FROM dw.FactSalesPerformance)&lt;&gt;259543 THROW 50309,'Warehouse Profit mismatch',1;&#xA;INSERT audit.SSISAcceptanceCase(SuiteID,CaseNumber,BatchID,WarehouseRows,WarehouseSales)&#xA;VALUES(CONVERT(uniqueidentifier,N'63d2403b-e12f-495d-a3ce-69efce27f1a6'),6,@b,4248,819811);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
