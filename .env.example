# Optional local paths; defaults work without .env.
COFFEE_DW_SQLITE_PATH=data/warehouse/coffee_dw.sqlite
# SQL Server bridge only. Keep credentials in .env (ignored by Git).
# Integrated authentication example; change SERVER to your instance.
COFFEE_DW_SQLSERVER_CONNECTION=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=CoffeeDW;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
