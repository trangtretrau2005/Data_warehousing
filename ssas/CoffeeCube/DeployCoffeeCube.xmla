              <Partitions>
                <Partition>
                  <ID>FactSalesPerformance</ID>
                  <Name>FactSalesPerformance</Name>
                  <Source xsi:type="TableBinding">
                    <DataSourceID>CoffeeDW</DataSourceID>
                    <DbSchemaName>dw</DbSchemaName>
                    <DbTableName>FactSalesPerformance</DbTableName>
                  </Source>
                  <StorageMode>Molap</StorageMode>
                  <ProcessingMode>Regular</ProcessingMode>
                </Partition>
              </Partitions>
            </MeasureGroup>
          </MeasureGroups>
          <Source>
            <DataSourceViewID>CoffeeDW</DataSourceViewID>
          </Source>
          <MdxScripts>
            <MdxScript>
              <ID>MdxScript</ID>
              <Name>MdxScript</Name>
              <Commands>
                <Command>
                  <Text>CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Gap]
 AS [Measures].[Sales] - [Measures].[Budget Sales],
 FORMAT_STRING = "#,##0.00",
 VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Budget Achievement]
 AS IIF(
      IsEmpty([Measures].[Budget Sales]) OR [Measures].[Budget Sales] = 0,
      NULL,
      [Measures].[Sales] / [Measures].[Budget Sales]
    ),
 FORMAT_STRING = "Percent",
 VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Profit Margin]
 AS IIF(
      IsEmpty([Measures].[Sales]) OR [Measures].[Sales] = 0,
      NULL,
      [Measures].[Profit] / [Measures].[Sales]
    ),
 FORMAT_STRING = "Percent",
 VISIBLE = 1;

-- Semi-additive policy for Inventory across time: evaluate at latest selected month
SCOPE ([Measures].[Inventory], [Dim Date].[Calendar].[Year].Members);
    THIS = (TAIL(EXISTING [Dim Date].[Date Key].[Date Key].Members, 1).Item(0), [Measures].[Inventory]);
END SCOPE;
SCOPE ([Measures].[Inventory], [Dim Date].[Calendar].[Quarter].Members);
    THIS = (TAIL(EXISTING [Dim Date].[Date Key].[Date Key].Members, 1).Item(0), [Measures].[Inventory]);
END SCOPE;
SCOPE ([Measures].[Inventory], [Dim Date].[Calendar].[All]);
    THIS = (TAIL(EXISTING [Dim Date].[Date Key].[Date Key].Members, 1).Item(0), [Measures].[Inventory]);
END SCOPE;</Text>
                </Command>
              </Commands>
            </MdxScript>
          </MdxScripts>
        </Cube>
      </Cubes>
      <DataSources>
        <DataSource xsi:type="RelationalDataSource">
          <ID>CoffeeDW</ID>
          <Name>CoffeeDW</Name>
          <ConnectionString>Provider=SQLNCLI11.1;Data Source=localhost;Integrated Security=SSPI;Initial Catalog=CoffeeDW</ConnectionString>
          <ImpersonationInfo>
            <ImpersonationMode>ImpersonateServiceAccount</ImpersonationMode>
          </ImpersonationInfo>
          <Timeout>PT0S</Timeout>
        </DataSource>
      </DataSources>
      <DataSourceViews>
        <DataSourceView>
          <ID>CoffeeDW</ID>
          <Name>CoffeeDW</Name>
