                    <ColumnID>DateKey</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Dim Location</CubeDimensionID>
          <Attributes>
            <Attribute>
